{
  "name": "Gatefold",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm ci && npm run build",
  "postStartCommand": "nohup bash -c 'npx vite preview --host 0.0.0.0 --port 4173 > /tmp/preview.log 2>&1 &'",
  "forwardPorts": [4173],
  "portsAttributes": {
    "4173": {
      "label": "Gatefold",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
