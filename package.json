{
  "name": "gatefold",
  "version": "1.0.0",
  "description": "Songs pressed as chips on X Layer: a chiptune studio where every instrument and every song is a TapeOut circuit",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --sequence.shuffle",
    "test:cov": "vitest run --coverage --sequence.shuffle",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "playwright test",
    "songs": "tsx scripts/build-songs.ts",
    "gatefold": "tsx src/cli/gatefold.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "viem": "^2.57.20",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
