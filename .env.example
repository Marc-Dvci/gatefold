# Copy to .env and fill in. Never commit .env. Every variable the code reads is listed here; none is needed to run the
# site or the tests.
# Live deployment only (scripts/deploy.ts --live --yes): the deployer's private key, which signs every transaction.
GATEFOLD_DEPLOYER_KEY=
# X Layer node for the deploy and conformance scripts (default https://rpc.xlayer.tech).
XLAYER_RPC=
# Path to anvil for the fork rehearsal (default: anvil on the PATH).
ANVIL=
# Deployment file the site is built against (default deployments/xlayer.json; the deploy script sets it).
GATEFOLD_DEPLOYMENT_FILE=
